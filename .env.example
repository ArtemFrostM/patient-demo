# Copy to .env and fill in the secrets: cp .env.example .env
# .env is git-ignored; compose refuses to start while a required secret is missing.

# --- Postgres (both databases use the same user/password) ---
POSTGRES_DB=patient_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

DB_HOST_PORT=5432
APP_HOST_PORT=8380

REF_DATA_DB=ref_data
REF_DATA_DB_HOST_PORT=5433
REF_DATA_APP_HOST_PORT=8381

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_HOST_PORT=8180

# Client secrets: imported into the realm by Keycloak AND read by the services,
# so each value lives only here (and in a Secret in Kubernetes).
# Generate e.g. with: openssl rand -base64 24
REF_DATA_CLIENT_SECRET=change-me
REF_DATA_ADMIN_CLIENT_SECRET=change-me
